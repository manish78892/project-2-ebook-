<% layout('layouts/boilerplate.ejs') %>

<body>
  <h2 class="text-center mb-4">All Books List</h2>

  <div class="container">
    <div class="row row-cols-lg-5 row-cols-md-3 row-cols-sm-2 g-4">
      <% for (let book of books) { %>
        <div class="col">
          <div class="card h-100">

            <% if (book.coverImage) { %>
              <img 
                src="<%= book.coverImage %>" 
                class="card-img-top"
                alt="<%= book.title %>"
                style="height: 220px; object-fit: cover;"
              >
            <% } %>

            <div class="card-body d-flex flex-column">
              <h5 class="card-title"><%= book.title %></h5>
              <p class="card-text">
                <%= book.description?.substring(0, 80) %>...
              </p>

              <a 
                href="/books/<%= book._id %>/read" 
                class="btn btn-primary mt-auto read-btn"
              >
                Read Book
              </a>
            </div>

          </div>
        </div>
      <% } %>
    </div>
  </div>
</body>

<style>
  /* Modern card styling – no extra HTML, just visual polish */
  .card {
    border: none;
    border-radius: 1rem;
    box-shadow: 0 6px 12px rgba(0,0,0,0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    overflow: hidden;
  }
  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 25px rgba(0,0,0,0.1);
  }
  .card-img-top {
    border-top-left-radius: 1rem;
    border-top-right-radius: 1rem;
  }
  .btn-primary {
    background-color: #80b918;
    border-color: #80b918;
    border-radius: 2rem;
    transition: all 0.2s;
  }
  .btn-primary:hover {
    background-color: #6a9e13;
    border-color: #6a9e13;
    transform: translateY(-2px);
  }
  .card-title {
    font-weight: 600;
    font-size: 1.1rem;
  }
  .card-text {
    font-size: 0.9rem;
    color: #6c757d;
  }
</style>