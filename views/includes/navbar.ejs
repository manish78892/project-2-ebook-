<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top py-2">
  <div class="container-fluid px-3 px-lg-4">
    <!-- Brand -->
    <a class="navbar-brand fw-bold" href="/">
      <i class="fa-solid fa-swatchbook me-1"></i> ebook
    </a>

    <!-- Toggler -->
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Navbar content -->
    <div class="collapse navbar-collapse" id="navbarNav">
      <!-- Left side links -->
      <ul class="navbar-nav me-auto mb-2 mb-md-0">
        <li class="nav-item">
          <a class="nav-link" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/books">All Books</a>
        </li>
        <% if(currentUser && currentUser.role === "admin") { %>
        <li class="nav-item">
          <a class="nav-link admin-link" href="/admin/dashboard">
            <i class="fa-solid fa-gauge-high me-1"></i> Admin Panel
          </a>
        </li>
        <% } %>
      </ul>

      <!-- Search form (visible only for logged in users) -->
      <% if (currentUser) { %>
      <form class="d-flex mx-auto my-2 my-md-0 search-form" action="/books" method="GET">
        <div class="input-group">
          <span class="input-group-text bg-transparent border-end-0">
            <i class="fa-solid fa-magnifying-glass"></i>
          </span>
          <input 
            class="form-control border-start-0 ps-0" 
            type="search" 
            name="search"
            placeholder="Search books by title, author..."
            aria-label="Search"
          >
          <button class="btn btn-outline-dark" type="submit">Search</button>
        </div>
      </form>
